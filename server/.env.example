# ===== الخادم =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===== قاعدة البيانات (PostgreSQL) =====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hall_booking
# اجعلها true عند استخدام استضافة تتطلب SSL (Neon, Supabase, Render ...)
DB_SSL=false

# ===== المصادقة =====
# مفتاح طويل وعشوائي (مثال للتوليد: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# ===== قواعد الحجز =====
DEPOSIT_PERCENT=30
# أقل مدة (بالساعات) قبل الموعد يمكن للزبون فيها إلغاء حجزه
CANCEL_BEFORE_HOURS=48

# ===== البريد الإلكتروني (اختياري: بدونه تُطبع الرسائل في الطرفية) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="قاعة الحفلات <no-reply@example.com>"
